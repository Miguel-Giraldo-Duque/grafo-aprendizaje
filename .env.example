# Copia este archivo a .env y cambia la contraseña.
# Neo4j exige al menos 8 caracteres. No uses este valor en una máquina expuesta.
# No pongas barras ni signos $ en la contraseña: Compose y el healthcheck la leen tal cual.

NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar-esta-clave
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# ungraph 0.1.5 lee el prefijo UNGRAPH_. La aplicación copia NEO4J_* aquí si faltan.
UNGRAPH_NEO4J_URI=bolt://localhost:7687
UNGRAPH_NEO4J_USER=neo4j
UNGRAPH_NEO4J_PASSWORD=cambiar-esta-clave
UNGRAPH_NEO4J_DATABASE=neo4j

# ungraph 0.1.5 crea el índice vectorial con 384 dimensiones (all-MiniLM-L6-v2).
# No cambies el modelo: el índice dejaría de coincidir con los embeddings.
UNGRAPH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
